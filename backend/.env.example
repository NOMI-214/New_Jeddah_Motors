# Copy this file to .env and fill in real values for production.

SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=72

# Local dev (default): sqlite:///./showroom.db
# Production (Render/Railway/Neon/Supabase Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./showroom.db
# Comma-separated frontend URLs allowed to call the API.
cors_origins=http://localhost:5173

# ── Email (used to send the OTP code when the admin account is created) ──
# Leave SMTP_HOST blank during local dev — the OTP will just be printed
# to this terminal instead of emailed, so you can still test the flow.
#
# Example for Gmail (use an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#
# Example for a transactional provider like SendGrid/Mailgun/Resend:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=your-api-key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=
OTP_EXPIRE_MINUTES=10
